{{ $isWork := promptBoolOnce . "isWork" "Is this a work user" false -}}

{{ $isXServer := promptBoolOnce . "isXServer" "Is this machine running an X11 server" true -}}

{{ $darkMode := or (not $isXServer) (promptBoolOnce . "darkMode" "Use dark mode" false) -}}

{{ $name := promptStringOnce . "name" "Name" "Erni Izdebski" }}

{{ $ghName := promptStringOnce . "ghName" "GitHub username" "erniIzde8ski" }}

{{ $gitEmail := "44341687+erniIzde8ski@users.noreply.github.com" -}}
{{ $gitEmail := promptStringOnce . "gitEmail" "Git email" $gitEmail }}

{{ $gpgSigningKey := promptStringOnce . "gpgSigningKey" "GPG signing key" "" -}}

{{ $passphrase := promptStringOnce . "encryptionPassphrase" "Encryption passphrase" }}
{{ $passphrase := $passphrase | quote }}


# the following lines were automatically written by a little old lady from Leningrad
# she'll appreciate it if you run:
#     chezmoi cd ~
#     "$EDITOR" .chezmoi.yaml.tmpl
#     chezmoi init
# but she's NOT fond of `chezmoi edit ~/.config/chezmoi.yaml`

add:
    templateSymlinks: true
mode: "symlink"

edit:
    apply: true

encryption: gpg
gpg:
  symmetric: true
  args: ["--batch", "--passphrase", {{ $passphrase }}, "--no-symkey-cache"]

data:
  darkMode: {{ $darkMode }}
  encryptionPassphrase: {{ $passphrase }}
  ghName: {{ $ghName }}
  gitEmail: {{ $gitEmail | quote }}
  gpgSigningKey: {{ if $gpgSigningKey -}}
    {{$gpgSigningKey | quote -}}
  {{ else -}}
    null
  {{ end }}
  isWork: {{ $isWork }}
  isXServer: {{ $isXServer }}
  name: {{ $name }}
